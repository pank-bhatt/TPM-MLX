src/tpm_mlx/static/videos/**
!src/tpm_mlx/static/videos/.gitkeep


# Local internal plans and notes (never commit to public repo)
docs/
*_plan*.md

# Environment and secrets (never commit tokens)
.env
.env.*
!.env.example

# IDE configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
